{
  "name": "receipt_like_ledger",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && tsc -p tsconfig.functions.json && vite build",
    "lint": "oxlint",
    "test": "vitest run",
    "preview": "vite preview",
    "gen:test-seed": "node scripts/generate-test-seed.mjs",
    "db:init:test": "wrangler d1 execute receipt_ledger_db --remote --file=db/schema.test.sql",
    "db:seed:test": "wrangler d1 execute receipt_ledger_db --remote --file=db/seed.test.sql",
    "db:init:test:local": "wrangler d1 execute receipt_ledger_db --local --file=db/schema.test.sql",
    "db:seed:test:local": "wrangler d1 execute receipt_ledger_db --local --file=db/seed.test.sql"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.104.5",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.4"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250801.0",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "oxlint": "^1.75.0",
    "typescript": "~6.0.2",
    "vite": "^8.2.0",
    "vitest": "^4.0.0"
  }
}
